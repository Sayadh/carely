# ─── Carely API configuration ───
NODE_ENV=development
PORT=4000
# Public origin of the web app (used for links in emails and the CSRF Origin check). Comma-separate extra origins.
APP_ORIGIN=http://localhost:3000
# Number of reverse-proxy hops to trust for client IPs (Nuxt proxy = 1, Nuxt + Nginx/Passenger = 2)
TRUST_PROXY=1

# MySQL 8 / MariaDB 10.6+ — utf8mb4. Keep the pool small on shared hosting.
DATABASE_URL="mysql://carely:carely_dev@localhost:3306/carely?connection_limit=5&pool_timeout=10"
# Only needed for `prisma migrate dev` when your DB user cannot create databases.
# SHADOW_DATABASE_URL="mysql://carely:carely_dev@localhost:3306/carely_shadow"

# Sessions
SESSION_COOKIE_NAME=carely_session
SESSION_TTL_DAYS=30
# Secure cookies require HTTPS. Must be true in production.
COOKIE_SECURE=false

# Request lifecycle
ACCEPTED_REQUEST_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60

# Token protecting POST /api/internal/jobs/run (cron via curl). Generate: openssl rand -hex 32
JOBS_TOKEN=

# Mail: "database" (local inbox at /api/dev/mail, dev only), "console" (log only, dev only) or "smtp" (production)
MAIL_DRIVER=database
MAIL_FROM="Carely <no-reply@carely.am>"

# Media storage: "local" (filesystem) or "s3" (S3-compatible)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for objects in the public bucket (CDN or bucket URL). Leave empty to stream through the API.
S3_PUBLIC_BASE_URL=

# Show the demo-environment notice and allow demo seeding. Never enable in production.
DEMO_MODE=true
LOG_LEVEL=info

# Client requests go to the Carely team ("leads", admin → Հայտեր); professionals never receive them.
# true = re-enable the legacy direct booking flow (client → professional accepts → client confirms).
DIRECT_REQUESTS_ENABLED=false
# New-request alerts in Telegram: create a bot with @BotFather. TELEGRAM_CHAT_ID = one or more chat ids, comma-separated
# (e.g. 529901132,123456789). Each person must open the bot and press Start once, otherwise Telegram blocks the message.
# Both empty = no alerts (requests are still stored and shown in the admin panel).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP (MAIL_DRIVER=smtp). cPanel mailboxes usually work with port 465 + SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
