# ─── Carely web (Nuxt) ───
# Where the Nuxt server reaches the NestJS API (server-side only; the browser always uses same-origin /api).
NUXT_API_INTERNAL_URL=http://127.0.0.1:4000
# Public site URL — canonical links, hreflang, sitemap.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Shows the demo-environment banner. Must be false in production.
NUXT_PUBLIC_DEMO_MODE=true
# Homepage hero is a slideshow, one slide per category, with built-in photos in public/images/hero/<slug>.webp.
# Optional override for every slide (empty = built-in photos):
NUXT_PUBLIC_HERO_IMAGE=
# Optional override per category (e.g. /images/hero-childcare.jpg in apps/web/public). Empty = the value above, then built-in.
NUXT_PUBLIC_HERO_IMAGE_CHILDCARE=
NUXT_PUBLIC_HERO_IMAGE_ELDERLY_CARE=
NUXT_PUBLIC_HERO_IMAGE_PATIENT_CARE=
NUXT_PUBLIC_HERO_IMAGE_NURSING=
NUXT_PUBLIC_HERO_IMAGE_PET_CARE=
NUXT_PUBLIC_HERO_IMAGE_DISABILITY_CARE=
NUXT_PUBLIC_HERO_IMAGE_PERSONAL_ASSISTANCE=
NUXT_PUBLIC_HERO_IMAGE_HOME_HELP=
# Carely team phone for "Call us" buttons (bottom bar, profiles, homepage, request page, footer). Empty = default +37493999913.
NUXT_PUBLIC_SUPPORT_PHONE=+37493999913
PORT=3000
