# ─── Carely API — production (cPanel) ───────────────────────────────────────────────────────────────
# Copy to /home/<cpanel-user>/carely_api/.env and fill in. Never commit the real file; never reuse SEA Furniture values.
NODE_ENV=production

# MariaDB on the same hosting. URL-encode special characters in the password (@ → %40, # → %23, : → %3A, / → %2F).
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME?connection_limit=5&pool_timeout=10"

# Public site address (CSRF origin check, links in emails and Telegram).
APP_ORIGIN=https://carely.am
# Shared secret with the website (same value as NUXT_API_PROXY_SECRET in carely_web/.env). ≥32 random characters.
# With it, api.carely.am only answers the Carely website (plus /api/health for monitoring).
PROXY_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
TRUST_PROXY=1

# Sessions
SESSION_COOKIE_NAME=carely_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=true
PASSWORD_RESET_TTL_MINUTES=60

# Cron jobs endpoint token, ≥32 random characters.
JOBS_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

# Outgoing mail (password reset etc.). Production refuses to start without SMTP.
MAIL_DRIVER=smtp
MAIL_FROM="Carely <no-reply@carely.am>"
SMTP_HOST=CHANGE_ME
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME

# Uploaded portraits and verification documents stay inside this app root (var/storage), never in public_html.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/storage

# Requests go to the Carely team; keep legacy direct booking off.
DIRECT_REQUESTS_ENABLED=false
DEMO_MODE=false

# New-request alerts. Chat ids comma-separated; each person must press Start in the bot once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=info
