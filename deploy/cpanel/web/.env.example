# ─── Carely website — production (cPanel) ───────────────────────────────────────────────────────────
# Copy to /home/<cpanel-user>/carely_web/.env and fill in. Never commit the real file.
# NUXT_API_* values are server-only: they are never sent to the browser.

# Where the website's server reaches the API (the browser always calls https://carely.am/api on the same origin).
NUXT_API_INTERNAL_URL=https://api.carely.am
# Same value as PROXY_SECRET in carely_api/.env.
NUXT_API_PROXY_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Public values (visible in the page).
NUXT_PUBLIC_SITE_URL=https://carely.am
NUXT_PUBLIC_DEMO_MODE=false
NUXT_PUBLIC_SUPPORT_PHONE=+37493999913
NUXT_PUBLIC_SUPPORT_EMAIL=
